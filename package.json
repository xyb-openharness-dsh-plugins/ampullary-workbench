{
  "name": "@xyb-community/ampullary-workbench",
  "version": "0.1.2",
  "description": "本机优先的壶腹部腺癌（Ampullary Adenocarcinoma）病理与术前胆道引流档案、胰十二指肠切除术后随访、黄疸与营养代谢、临床试验三步匹配工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node --check lib/layout.js && node scripts/check-workbench-package.mjs . && node scripts/check-host-contract.mjs && node scripts/smoke-activate.mjs && node scripts/check-probe-coverage.mjs && node scripts/build-version.mjs --check && node scripts/check-version-literal.mjs && node scripts/check-wording.mjs . && node scripts/check-static-refs.mjs && node scripts/check-choice-limit.mjs && node scripts/check-assertion-strength.mjs && node --test test/*.test.mjs && node scripts/check-derivative-leftovers.mjs . && node scripts/check-primer-links.mjs",
    "check:version-literal": "node scripts/check-version-literal.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "check:static-refs": "node scripts/check-static-refs.mjs",
    "check:choice-limit": "node scripts/check-choice-limit.mjs && node scripts/check-assertion-strength.mjs",
    "smoke:activate": "node scripts/smoke-activate.mjs",
    "verify:desktop": "node scripts/verify-desktop-load.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run audit && npm run probe:proto",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs",
    "build:proto-data": "node scripts/build-prototype-data.mjs",
    "probe:proto": "node scripts/probe-proto.mjs",
    "build:version": "node scripts/build-version.mjs",
    "check:version": "node scripts/build-version.mjs --check",
    "check:wording": "node scripts/check-wording.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/ampullary-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
